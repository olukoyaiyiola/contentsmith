# Model Configuration (Server Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# OpenRouter Qwen Image Generation (Optional or Primary)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_IMAGE_MODEL=qwen/qwen-image-3
IMAGE_PROVIDER=openrouter

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Abuse & Rate Limiting Controls
DAILY_TRIAL_CAP=50
IP_HASH_SALT=generate_a_random_salt_for_ip_hashing
CRON_SECRET=generate_a_secure_token_for_cron_cleanup

# Bot Protection (Optional / Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
